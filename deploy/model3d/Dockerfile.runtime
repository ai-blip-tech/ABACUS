# syntax=docker/dockerfile:1.7
# Public runtime image: libraries/code only. No weights, references or credentials.
FROM runpod/pytorch:1.5.0-cu1281-torch280-ubuntu2404
ARG TRELLIS_COMMIT=75fbf0183001ed9876c8dbb35de6b68552ee08bd
ENV TRELLIS_COMMIT=$TRELLIS_COMMIT HF_HOME=/opt/hf TORCH_CUDA_ARCH_LIST=12.0 MAX_JOBS=2 CPLUS_INCLUDE_PATH=/usr/include/eigen3
RUN apt-get update -qq && apt-get install -y --no-install-recommends git build-essential libeigen3-dev libgl1 libglib2.0-0 ca-certificates && rm -rf /var/lib/apt/lists/*
RUN git clone --recursive https://github.com/microsoft/TRELLIS.2.git /opt/TRELLIS.2 && cd /opt/TRELLIS.2 && git checkout "$TRELLIS_COMMIT" && git submodule update --init --recursive
WORKDIR /opt/TRELLIS.2
RUN bash setup.sh --basic --cumesh --o-voxel --flexgemm --nvdiffrast --nvdiffrec && python -m pip install transformers==4.57.1 einops==0.8.2 && python -m pip install --no-deps xformers==0.0.32.post2 && rm -rf /root/.cache/pip /tmp/extensions
COPY services/model3d/ /opt/model3d/
RUN python /opt/model3d/write_build_manifest.py && python -m pip freeze > /opt/model3d/requirements-frozen.txt
ENV PYTHONPATH=/opt/TRELLIS.2:/opt/model3d
LABEL org.opencontainers.image.source=https://github.com/ai-blip-tech/ABACUS
ENTRYPOINT ["bash","/opt/model3d/entrypoint.sh"]
