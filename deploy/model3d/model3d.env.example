MODEL3D_STORAGE_DIR=/var/lib/room-design/model-library
MODEL3D_PORT=4199
MODEL3D_INTERNAL_URL=http://127.0.0.1:4199
MODEL3D_PUBLIC_URL=https://roomdesign.com.ru/api/models3d/worker
# Set once on the server. Same secret goes into the Next.js server environment.
MODEL3D_SERVICE_SECRET=
RUNPOD_API_KEY=
HF_TOKEN=
MODEL3D_BUNDLED_WEIGHTS=false
# No paid launches until image, revision and budget have been validated.
MODEL3D_GENERATION_ENABLED=false
MODEL3D_RUNPOD_IMAGE=
MODEL3D_ENGINE_REVISION=
MODEL3D_REGISTRY_AUTH_ID=
MODEL3D_NAMESPACE=roomdesign-model3d
MODEL3D_MAX_PODS=1
MODEL3D_MAX_JOB_SECONDS=900
MODEL3D_GPU_HOURLY_USD=2.51
MODEL3D_DAILY_BUDGET_USD=0
MODEL3D_GPU_TYPE=NVIDIA RTX PRO 6000 Blackwell Server Edition
# Add actual catalogue image CDN hosts only after verification.
MODEL3D_IMAGE_HOSTS=norrmobler.ru,www.norrmobler.ru,leve-home.ru,www.leve-home.ru,levehome.ru,www.levehome.ru,gomoon.ru,www.gomoon.ru
